{
  "name": "issue-map",
  "version": "0.3.1",
  "description": "Draws the blocking relationships between your GitHub Issues as a one-page dev map: which issues can be picked up now, which are waiting on what, and where the critical path runs.",
  "keywords": [
    "bun",
    "cli",
    "dependency-graph",
    "github",
    "issues"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gunter1020/issue-map.git"
  },
  "bin": {
    "issue-map": "./scripts/issue-map-serve.ts",
    "issue-map-build": "./scripts/issue-map.ts"
  },
  "files": [
    "README.zh-TW.md",
    "README.zh-CN.md",
    "README.ja.md",
    "scripts/issue-map.ts",
    "scripts/issue-map-i18n.ts",
    "scripts/issue-map-model.ts",
    "scripts/issue-map-page.ts",
    "scripts/issue-map-view.ts",
    "scripts/issue-map-serve.ts",
    "scripts/issue-map.html"
  ],
  "type": "module",
  "scripts": {
    "issue-map": "bun run scripts/issue-map.ts",
    "issue-map:serve": "ISSUE_MAP_OPEN=0 bun --watch scripts/issue-map-serve.ts",
    "typecheck": "tsc --noEmit",
    "mutate": "bun run scripts/mutate.ts",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "check": "bun run lint && bun run format:check && bun run typecheck"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.76.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.0.0"
  }
}
